# Build output. Cargo.lock *is* committed: this workspace produces a binary and a deployable
# node, so a reproducible dependency set is the point.
/target

# Local research and scratch material — must never be committed
/notes/
/research/
/scratch/
*.local.md

# Website (Docusaurus) — build artefacts and dependencies
/website/node_modules/
/website/build/
/website/.docusaurus/
/website/.cache-loader/
npm-debug.log*
yarn-error.log*

# Local agent/tool configuration and e2e-run artefacts — machine state, not project content.
/.flux/
/tone.wav

# Agent worktrees: full checkouts of this repository, created by tooling.
# They must never be committed — as gitlinks they become broken submodule refs.
.claude/
